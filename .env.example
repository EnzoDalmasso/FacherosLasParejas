# Número de WhatsApp del negocio, en formato internacional sin signos (código de país + área + número).
# Usado para el botón flotante, la consulta de producto y el checkout del carrito.
NEXT_PUBLIC_WHATSAPP_NUMBER=5493471681570

# URL pública del sitio, usada para metadata (Open Graph), sitemap.xml y robots.txt.
# En Vercel, configurar con el dominio final una vez desplegado.
NEXT_PUBLIC_SITE_URL=https://facheros-tienda.vercel.app
